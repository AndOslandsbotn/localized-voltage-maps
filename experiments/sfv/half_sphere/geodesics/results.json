        "strategy": "prefix",
        "size": 50000
      },
      "dimension": {
        "strategy": "mle",
        "sample_size": 10000,
        "mle": {
          "k": 20
        },
        "fixed": {
          "d": 12.0
        }
      },
      "cells": {
        "n_cells": 300,
        "min_points_per_cell": 10,
        "placement": "kmeans",
        "kmeans": {
          "strategy": "auto",
          "cuml": {
            "init": "random",
            "max_iter": 30,
            "tol": 0.0001
          },
          "lloyd": {
            "iterations": 25
          }
        },
        "refine": {
          "strategy": "minibatch",
          "passes": 0,
          "tolerance": 0.01,
          "max_points": null
        },
        "masses": {
          "rel_error": 0.05,
          "max_points": null
        }
      },
      "graph": {
