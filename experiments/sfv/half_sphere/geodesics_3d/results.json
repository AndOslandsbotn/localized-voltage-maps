        "strategy": "prefix",
        "size": 50000
      },
      "dimension": {
        "strategy": "mle",
        "sample_size": 10000,
        "mle": {
          "k": 20
        },
        "fixed": {
          "d": 12.0
        }
      },
      "cells": {
        "n_cells": 300,
        "min_points_per_cell": 10,
        "placement": "kmeans",
        "kmeans": {
          "strategy": "auto",
          "cuml": {
            "init": "random",
            "max_iter": 30,
            "tol": 0.0001
          },
          "lloyd": {
            "iterations": 25
          }
        },
        "refine": {
          "strategy": "minibatch",
          "passes": 0,
          "tolerance": 0.01,
          "max_points": null
        },
        "masses": {
          "rel_error": 0.05,
          "max_points": null
        }
      },
      "graph": {
        "radius": {
          "strategy": "adaptive_per_cell",
          "adaptive_per_cell": {
            "k": 10
          },
          "knn": {
            "k": 10
          },
          "point_knn": {
            "k": 10,
            "sample_size": 5000
          },
          "centroid_spacing": {
            "multiplier": 3.0
          }
        },
        "kernel": {
          "strategy": "radial",
          "gaussian": {
            "sigma": 0.3333,
            "cutoff": 3.0
          }
        },
        "connect": true
      },
      "voltage": {
        "threshold": 0.001
      },
      "landmarks": {
        "count": {
          "strategy": "dimension",
          "dimension": {
            "multiplier": 1.0
          },
          "fixed": {
            "n": 20
          }
        },
        "mutual_information": {
          "noise_std": 0.01
        },
        "reach": {
          "k": null,
          "share": 0.9,
          "rel_tolerance": 0.05,
          "rho_g_bounds": [
            1e-06,
            1000000.0
          ]
        }
      },
      "extension": {
        "strategy": "average",
        "kernel": "nearest",
        "nearest": {
          "k": 3,
          "sharpness": 16.0
        }
      },
      "embedding": {
        "n_components": 2,
        "distance_floor": 1e-10,
