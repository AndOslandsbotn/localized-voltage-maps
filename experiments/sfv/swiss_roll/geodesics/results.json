            "k": 5
          },
          "knn": {
            "k": 10
          },
          "point_knn": {
            "k": 10,
            "sample_size": 5000
          },
          "centroid_spacing": {
            "multiplier": 3.0
          }
        },
        "kernel": {
          "strategy": "radial",
          "gaussian": {
            "sigma": 0.3333,
            "cutoff": 3.0
          }
        },
        "connect": true
      },
      "voltage": {
        "threshold": 0.001
      },
      "landmarks": {
        "count": {
          "strategy": "dimension",
          "dimension": {
            "multiplier": 1.0
          },
          "fixed": {
            "n": 20
          }
        },
        "mutual_information": {
          "noise_std": 0.01
        },
        "reach": {
          "k": null,
          "share": 0.9,
          "rel_tolerance": 0.05,
          "rho_g_bounds": [
            1e-06,
            1000000.0
